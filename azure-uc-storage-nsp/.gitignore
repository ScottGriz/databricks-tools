# Terraform working directory and state (state contains secrets/resource IDs)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Variable files with real values; terraform.tfvars.example stays tracked
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / credentials
.terraformrc
terraform.rc
.env
.env.*

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
